{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Dept stores outpaced the big categories",
    "subtitle": "Online spend 2024 → 2025 ($B). Hover a line"
  },
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/auspost_categories_2025.csv",
    "format": {
      "parse": {
        "spend_2025_bn": "number",
        "growth_pct": "number",
        "spend_2024_bn": "number"
      }
    }
  },
  "transform": [
    {
      "filter": {
        "field": "category",
        "oneOf": [
          "Online marketplaces",
          "Food & liquor",
          "Fashion & apparel",
          "Consumer electronics",
          "Department stores"
        ]
      }
    },
    {
      "fold": [
        "spend_2024_bn",
        "spend_2025_bn"
      ],
      "as": [
        "yr",
        "spend"
      ]
    },
    {
      "calculate": "datum.yr === 'spend_2024_bn' ? '2024' : '2025'",
      "as": "Year"
    },
    {
      "calculate": "datum.category === 'Department stores'",
      "as": "hl"
    }
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": null,
      "scale": {
        "range": [
          40,
          115
        ]
      },
      "axis": {
        "labelAngle": 0,
        "orient": "top",
        "domain": false,
        "ticks": false,
        "labelFontWeight": 700,
        "labelFontSize": 12
      }
    },
    "y": {
      "field": "spend",
      "type": "quantitative",
      "title": "Online spend ($B)",
      "scale": {
        "domain": [
          2,
          20
        ]
      },
      "axis": null
    },
    "detail": {
      "field": "category"
    },
    "color": {
      "condition": [
        {
          "param": "hoverCat",
          "empty": false,
          "value": "#222222"
        },
        {
          "test": "datum.hl",
          "value": "#1e8a5a"
        }
      ],
      "value": "#c2bfb7"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5
      },
      "params": [
        {
          "name": "hoverCat",
          "select": {
            "type": "point",
            "on": "mouseover",
            "fields": [
              "category"
            ],
            "clear": "mouseout"
          }
        }
      ]
    },
    {
      "mark": {
        "type": "circle",
        "size": 70,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "category"
          },
          {
            "field": "Year"
          },
          {
            "field": "spend",
            "format": "$.1f",
            "title": "Spend ($B)"
          },
          {
            "field": "growth_pct",
            "title": "Growth (%)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year === '2024'"
        },
        {
          "calculate": "'$' + format(datum.spend, '.1f')",
          "as": "lbl"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 10.5
      },
      "encoding": {
        "text": {
          "field": "lbl"
        },
        "color": {
          "condition": {
            "test": "datum.hl",
            "value": "#1e8a5a"
          },
          "value": "#6b7280"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year === '2025'"
        },
        {
          "calculate": "'$' + format(datum.spend, '.1f') + ' ' + {'Online marketplaces':'Marketplaces','Food & liquor':'Food & liquor','Fashion & apparel':'Fashion','Home & garden':'Home & garden','Consumer electronics':'Electronics','Hobbies & recreation':'Hobbies','Department stores':'Dept stores','Health & beauty':'Health & beauty','Books, stationery & media':'Books & media'}[datum.category] + ' +' + datum.growth_pct + '%'",
          "as": "lbl"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 10.5
      },
      "encoding": {
        "text": {
          "field": "lbl"
        },
        "color": {
          "condition": {
            "test": "datum.hl",
            "value": "#1e8a5a"
          },
          "value": "#222222"
        }
      }
    }
  ],
  "config": {
    "font": "IBM Plex Sans",
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "start",
      "fontSize": 15,
      "fontWeight": 700,
      "color": "#222222",
      "subtitleFontSize": 12,
      "subtitleColor": "#6b7280",
      "offset": 12
    },
    "axis": {
      "labelColor": "#6b7280",
      "titleColor": "#222222",
      "titleFontWeight": 600,
      "titleFontSize": 11,
      "labelFontSize": 11,
      "gridColor": "#e8e3d8",
      "domainColor": "#d2cec4",
      "tickColor": "#d2cec4"
    },
    "legend": {
      "labelColor": "#222222",
      "titleColor": "#222222",
      "titleFontSize": 11,
      "labelFontSize": 11,
      "titleFontWeight": 600
    },
    "text": {
      "font": "IBM Plex Sans",
      "color": "#222222"
    }
  }
}
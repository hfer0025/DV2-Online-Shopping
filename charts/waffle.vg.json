{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Who spends the online dollar?",
    "subtitle": "Share of 2025 online spend by generation"
  },
  "width": 250,
  "height": 250,
  "data": {
    "url": "data/waffle_generations.csv",
    "format": {
      "parse": {
        "id": "number",
        "col": "number",
        "row": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "{'Millennials':'$29.7B (36%)','Gen X':'$22.7B (27%)','Gen Z':'$14.6B (18%)','Baby Boomers':'$12.2B (15%)','Builders':'$3.4B (4%)'}[datum.generation]",
      "as": "spend"
    }
  ],
  "params": [
    {
      "name": "pickGen",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Millennials",
          "Gen X",
          "Gen Z",
          "Baby Boomers",
          "Builders"
        ],
        "name": "Highlight a generation: "
      }
    }
  ],
  "mark": {
    "type": "rect",
    "cornerRadius": 2,
    "stroke": "#ffffff",
    "strokeWidth": 2.5
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "generation",
      "type": "nominal",
      "scale": {
        "domain": [
          "Millennials",
          "Gen X",
          "Gen Z",
          "Baby Boomers",
          "Builders"
        ],
        "range": [
          "#1e8a5a",
          "#4a4740",
          "#8f8a80",
          "#c2bfb7",
          "#dedad2"
        ]
      },
      "legend": {
        "title": "1 square = 1% of $82.6B",
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 3,
        "labelFontSize": 12,
        "symbolType": "square",
        "symbolSize": 140,
        "titleLimit": 300,
        "labelExpr": "{'Millennials':'Millennials 36%','Gen X':'Gen X 27%','Gen Z':'Gen Z 18%','Baby Boomers':'Boomers 15%','Builders':'Builders 4%'}[datum.label]"
      }
    },
    "opacity": {
      "condition": {
        "test": "pickGen === 'All' || datum.generation === pickGen",
        "value": 1
      },
      "value": 0.15
    },
    "tooltip": [
      {
        "field": "generation",
        "title": "Generation"
      },
      {
        "field": "spend",
        "title": "Spend 2025"
      }
    ]
  },
  "config": {
    "font": "IBM Plex Sans",
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "start",
      "fontSize": 15,
      "fontWeight": 700,
      "color": "#222222",
      "subtitleFontSize": 12,
      "subtitleColor": "#6b7280",
      "offset": 12
    },
    "axis": {
      "labelColor": "#6b7280",
      "titleColor": "#222222",
      "titleFontWeight": 600,
      "titleFontSize": 11,
      "labelFontSize": 11,
      "gridColor": "#e8e3d8",
      "domainColor": "#d2cec4",
      "tickColor": "#d2cec4"
    },
    "legend": {
      "labelColor": "#222222",
      "titleColor": "#222222",
      "titleFontSize": 11,
      "labelFontSize": 11,
      "titleFontWeight": 600
    },
    "text": {
      "font": "IBM Plex Sans",
      "color": "#222222"
    }
  }
}
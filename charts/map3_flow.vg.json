{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Australians buy from overseas",
    "subtitle": "Line width = % of Australian cross-border shoppers who buy from each country (DHL, 2024). Hover a route"
  },
  "width": "container",
  "height": 330,
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/world.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.CONTINENT !== 'Antarctica'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.4
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.properties.ADM0_A3 === 'AUS'",
            "value": "#c3e2d1"
          },
          "value": "#ebeae7"
        }
      }
    },
    {
      "data": {
        "url": "data/dhl_flow_routes.csv",
        "format": {
          "parse": {
            "step": "number",
            "lon": "number",
            "lat": "number",
            "pct_shoppers": "number"
          }
        }
      },
      "mark": {
        "type": "line",
        "strokeCap": "round",
        "opacity": 0.85
      },
      "params": [
        {
          "name": "hoverRoute",
          "select": {
            "type": "point",
            "on": "mouseover",
            "fields": [
              "origin"
            ],
            "clear": "mouseout"
          }
        }
      ],
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "detail": {
          "field": "origin"
        },
        "order": {
          "field": "step",
          "type": "quantitative"
        },
        "strokeWidth": {
          "field": "pct_shoppers",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              60
            ],
            "range": [
              0,
              11
            ]
          },
          "legend": {
            "title": "% of Australian cross-border shoppers",
            "values": [
              20,
              40,
              55
            ],
            "orient": "bottom",
            "direction": "horizontal",
            "titleLimit": 400,
            "labelExpr": "datum.label + '%'"
          }
        },
        "color": {
          "condition": [
            {
              "param": "hoverRoute",
              "empty": false,
              "value": "#222222"
            },
            {
              "test": "datum.origin === 'United States'",
              "value": "#1e8a5a"
            }
          ],
          "value": "#b3afa6"
        },
        "tooltip": [
          {
            "field": "origin",
            "title": "Buys from"
          },
          {
            "field": "pct_shoppers",
            "title": "% of shoppers"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/dhl_origins.csv",
        "format": {
          "parse": {
            "lon": "number",
            "lat": "number",
            "pct_shoppers": "number"
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "circle",
            "size": 45,
            "color": "#222222",
            "opacity": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.origin !== 'Germany' && datum.origin !== 'United Kingdom'"
            },
            {
              "calculate": "datum.origin + ' ' + datum.pct_shoppers + '%'",
              "as": "lbl"
            }
          ],
          "mark": {
            "type": "text",
            "fontWeight": 700,
            "fontSize": 11,
            "dy": 14
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "lbl"
            },
            "color": {
              "condition": {
                "test": "datum.origin === 'United States'",
                "value": "#1e8a5a"
              },
              "value": "#222222"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.origin === 'United Kingdom'"
            },
            {
              "calculate": "'UK ' + datum.pct_shoppers + '%'",
              "as": "lbl"
            }
          ],
          "mark": {
            "type": "text",
            "fontWeight": 700,
            "fontSize": 11,
            "align": "right",
            "dx": -7,
            "dy": -6,
            "color": "#222222"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "lbl"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.origin === 'Germany'"
            },
            {
              "calculate": "datum.origin + ' ' + datum.pct_shoppers + '%'",
              "as": "lbl"
            }
          ],
          "mark": {
            "type": "text",
            "fontWeight": 700,
            "fontSize": 11,
            "align": "left",
            "dx": 7,
            "dy": 10,
            "color": "#222222"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "lbl"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "lon": 134,
            "lat": -25.5
          }
        ]
      },
      "mark": {
        "type": "circle",
        "size": 120,
        "color": "#1e8a5a",
        "opacity": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    }
  ],
  "config": {
    "font": "IBM Plex Sans",
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "start",
      "fontSize": 15,
      "fontWeight": 700,
      "color": "#222222",
      "subtitleFontSize": 12,
      "subtitleColor": "#6b7280",
      "offset": 12
    },
    "axis": {
      "labelColor": "#6b7280",
      "titleColor": "#222222",
      "titleFontWeight": 600,
      "titleFontSize": 11,
      "labelFontSize": 11,
      "gridColor": "#e8e3d8",
      "domainColor": "#d2cec4",
      "tickColor": "#d2cec4"
    },
    "legend": {
      "labelColor": "#222222",
      "titleColor": "#222222",
      "titleFontSize": 11,
      "labelFontSize": 11,
      "titleFontWeight": 600
    },
    "text": {
      "font": "IBM Plex Sans",
      "color": "#222222"
    }
  }
}